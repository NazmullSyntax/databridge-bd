# ═══════════════════════════════════════════════════
# DataBridge BD — Environment Variables Template
# এই ফাইল GitHub-এ commit হবে (safe)।
# এখানে dummy values। আসল মান .env ফাইলে রাখুন (ignored)।
# ═══════════════════════════════════════════════════

# ─── Node ───
NODE_ENV=development
PORT=5000

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (PostgreSQL) ───
DATABASE_URL="postgresql://databridge:password@localhost:5432/databridge_dev"

# ─── Auth ───
JWT_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-another-64-char-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ─── Email (Resend) ───
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="DataBridge BD <noreply@databridgebd.com>"

# ─── File Upload (Cloudinary) ───
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
UPLOAD_MAX_SIZE_MB=10

# ─── URLs ───
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
COOKIE_DOMAIN=localhost

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
